{
  "manifest_version": 3,
  "name": "Working Time Calculator",
  "version": "8.0.1",
  "description": "Track your Zoho People working hours, get late-day and leave suggestions, and log attendance or apply leave in one click.",
  "author": "Luuns",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "cookies"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": [
    "https://people.zoho.com/*",
    "https://accounts.zoho.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
